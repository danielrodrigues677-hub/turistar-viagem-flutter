# API Configuration
API_URL=https://api.agenciaturistar.com.br
API_TIMEOUT=30

# Pátria Consolidadora
PATRIA_API_KEY=sua_chave_api_patria
PATRIA_API_SECRET=seu_secret_patria
PATRIA_API_URL=https://api.patria.com.br

# Stripe Payment
STRIPE_PUBLIC_KEY=pk_live_sua_chave_publica
STRIPE_SECRET_KEY=sk_live_sua_chave_secreta

# Firebase
FIREBASE_PROJECT_ID=seu_projeto_firebase
FIREBASE_API_KEY=sua_chave_firebase
FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
FIREBASE_DATABASE_URL=https://seu_projeto.firebaseio.com
FIREBASE_STORAGE_BUCKET=seu_projeto.appspot.com

# App Configuration
APP_NAME=Turistar Viagem
APP_VERSION=1.0.0
APP_BUILD=1
DEBUG_MODE=false

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_app

# Analytics
ANALYTICS_ENABLED=true
CRASH_REPORTING_ENABLED=true

# Feature Flags
ENABLE_HOTELS=true
ENABLE_CARS=true
ENABLE_INSURANCE=true
ENABLE_MULTI_CITY=true
