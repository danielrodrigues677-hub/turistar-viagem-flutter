# ============================================================================
# Variáveis de Ambiente - Turistar Viagem
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores reais
# cp .env.example .env
# ============================================================================

# ============================================================================
# FIREBASE
# ============================================================================
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_API_KEY=sua-chave-api-firebase
FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
FIREBASE_DATABASE_URL=https://seu-projeto.firebaseio.com
FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=seu-sender-id
FIREBASE_APP_ID=seu-app-id
FIREBASE_MEASUREMENT_ID=seu-measurement-id

# ============================================================================
# CONSOLIDADORAS - SAKURA
# ============================================================================
SAKURA_API_KEY=sua-chave-api-sakura
SAKURA_API_URL=https://api.sakura.com.br
SAKURA_API_VERSION=v2
SAKURA_TIMEOUT=30000

# ============================================================================
# CONSOLIDADORAS - PATRIA
# ============================================================================
PATRIA_API_KEY=sua-chave-api-patria
PATRIA_API_SECRET=seu-secret-patria
PATRIA_API_URL=https://api.patria.com.br
PATRIA_API_VERSION=v1
PATRIA_TIMEOUT=30000

# ============================================================================
# CONFIGURAÇÕES DE APLICATIVO
# ============================================================================
APP_NAME=Turistar Viagem
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
APP_ENVIRONMENT=production
DEBUG_MODE=false

# ============================================================================
# URLS
# ============================================================================
API_BASE_URL=https://api.agenciaturistar.com.br
API_TIMEOUT=30000
WEB_URL=https://app.agenciaturistar.com.br
FIREBASE_HOSTING_URL=https://turistar-viagem.firebaseapp.com

# ============================================================================
# GOOGLE MAPS
# ============================================================================
GOOGLE_MAPS_API_KEY=sua-chave-google-maps

# ============================================================================
# PAGAMENTOS - STRIPE
# ============================================================================
STRIPE_PUBLIC_KEY=pk_live_sua-chave-publica
STRIPE_SECRET_KEY=sk_live_sua-chave-secreta

# ============================================================================
# COMUNICAÇÃO - TWILIO
# ============================================================================
TWILIO_ACCOUNT_SID=seu-twilio-account-sid
TWILIO_AUTH_TOKEN=seu-twilio-auth-token
TWILIO_PHONE_NUMBER=+55-seu-numero

# ============================================================================
# EMAIL - SENDGRID
# ============================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=sua-chave-sendgrid
SENDGRID_API_KEY=sua-chave-sendgrid
SENDGRID_FROM_EMAIL=noreply@agenciaturistar.com.br
SENDGRID_FROM_NAME=Turistar Viagem

# ============================================================================
# ANALYTICS
# ============================================================================
ANALYTICS_ENABLED=true
ANALYTICS_TRACKING_ID=seu-tracking-id
ANALYTICS_MEASUREMENT_ID=seu-measurement-id
CRASH_REPORTING_ENABLED=true

# ============================================================================
# SENTRY (Error Tracking)
# ============================================================================
SENTRY_DSN=https://seu-sentry-dsn
SENTRY_ENVIRONMENT=production
SENTRY_TRACE_SAMPLE_RATE=1.0

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=console
VERBOSE_LOGGING=false

# ============================================================================
# FEATURES FLAGS
# ============================================================================
ENABLE_HOTELS=true
ENABLE_CARS=true
ENABLE_INSURANCE=true
ENABLE_MULTI_CITY=true
FEATURE_PAYMENT_ENABLED=true
FEATURE_BOOKING_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true
FEATURE_BETA_FEATURES_ENABLED=false

# ============================================================================
# TIMEOUTS E LIMITES
# ============================================================================
REQUEST_TIMEOUT=30000
MAX_RETRIES=3
CACHE_DURATION=3600
MAX_FILE_SIZE=10485760

# ============================================================================
# MODO DEBUG
# ============================================================================
SHOW_PERFORMANCE_METRICS=false
